# 依赖目录
node_modules
**/node_modules
npm-debug.log*

# 日志文件
logs
*.log
用户反馈日志/
用户反馈日志/**

# 运行时数据
pids
*.pid
*.seed
*.pid.lock

# 覆盖率目录
coverage
.nyc_output

# 依赖锁定文件（我们会在容器内重新生成）
package-lock.json
!frontend-v2/package-lock.json

# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 编辑器配置
.vscode
.idea
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db

# Git相关
.git

# 测试文件
test-*.js
*.test.js
*.spec.js

# 临时文件
tmp
temp

# Docker相关（保留根目录的Dockerfile）
docker-compose*.yml

# 其他不需要的文件
*.tgz
*.tar.gz

# 下载目录（避免复制到镜像中）
downloads/
downloads/**

# 数据库和缓存文件
database/
database/**
*.db
*.db-journal
*.db-shm
*.db-wal

# Python缓存
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# 前端构建产物与本地缓存
frontend-v2/dist/
frontend-v2/.vite/
frontend-v2/.cache/
frontend-v2/.nuxt/

# 子目录的配置文件（避免冲突）
dyd/.dockerignore
dyd/.gitignore

# 备份文件和旧版文件（订阅模块拆分后的备份）
**/旧版*
**/*备份*
**/*backup*
**/*.backup
routers/subscribe/旧版完整，供排查参考使用subscribe.py
# 明确保留 routers/backup.py（这是功能模块，不是备份文件）
!routers/backup.py

# 文档文件（生产镜像中不需要，但保留 README）
**/*.md
!README.md
!routers/subscribe/README.md
!_vendor_streamget-main/**/*.md

# -------------------------------------------------------------------
# 项目元数据 / 开发脚本（不参与镜像运行，避免进入构建上下文）
# -------------------------------------------------------------------
easy-vdl.code-workspace
backup.sh
build_and_run.sh
build_and_push_dockerhub.sh

# Cursor / 编辑器生成的辅助目录（如果存在）
.agent/
.agent/**
.claude/
.claude/**
.cursor
.cursorignore
.deepseek/
.deepseek/**
.history

# 不参与镜像构建的辅助项目目录（如本地 skill、自动化脚本等）
skills/
skills/**

# 本地构建 / 发布辅助文件（由宿主机脚本使用，不需要进入 Docker 构建上下文）
build-version.env
generate-release-version.sh
build_and_run_arm64.sh
build_and_push_dockerhub_arm64.sh
